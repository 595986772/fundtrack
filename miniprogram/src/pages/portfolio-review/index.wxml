<view class="page portfolio-review-page">
  <view class="row"><button class="link" bindtap="holdings">持仓</button><text class="muted small">收益与风险</text></view>
  <view class="row"><view class="heading grow">{{name || '收益与风险'}}</view><button class="icon-button" bindtap="load" disabled="{{loading||job.busy}}" aria-label="重读收益与风险"><image class="icon" src="/assets/refresh.png" /></button></view>
  <view class="field"><text class="label">分析区间</text><picker range="{{periodLabels}}" value="{{index}}" bindchange="period" disabled="{{loading||job.busy}}"><view class="select">{{periodLabels[index]}}</view></picker></view>
  <view wx:if="{{loading}}" class="notice">正在读取收益与风险…</view><view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view wx:if="{{result}}">
    <view class="section"><view class="section-title">历史收益与波动</view><view class="footnote">{{result.performance ? result.performance.performance_label : '历史业绩暂不可用'}}</view>
      <view wx:if="{{result.performance}}" class="footnote">{{result.performance.period_start}} 至 {{result.performance.period_end}} · {{result.performance.observation_count}}个观察日</view>
      <view class="metrics"><view wx:for="{{metrics}}" wx:key="label"><view class="muted small">{{item.label}}</view><view class="value numeric">{{item.value}}</view></view></view>
      <button class="link" bindtap="detail" data-kind="performance">收益明细与曲线</button><view wx:for="{{warnings}}" wx:key="index" class="footnote">{{item}}</view>
    </view>
    <view class="section"><view class="section-title">{{result.assessment ? result.assessment.state_label : '风险信息暂不完整'}}</view><view class="prose">{{result.assessment ? result.assessment.summary : ''}}</view>
      <view wx:if="{{result.assessment}}" class="footnote">规则研判 · 截至 {{result.assessment.assessment_date}}</view>
      <view wx:for="{{risk}}" wx:key="id" class="item"><view>{{item.title}}</view><view class="small prose">{{item.detail}}</view><view class="footnote">{{item.id}}</view></view>
      <button class="link" bindtap="detail" data-kind="risk">完整风险证据</button>
    </view>
    <view wx:for="{{result.gaps}}" wx:key="section" class="notice">{{item.section==='performance'?'业绩':'风险'}}暂不可用：{{item.message}}</view>
    <view class="section"><view class="section-title">配置研判</view><view class="footnote">{{result.latest_report ? '已有历史报告，内容不会随持仓自动更新。' : '当前区间尚无配置报告。'}}</view>
      <view wx:if="{{job.message}}" class="notice">{{job.message}}<button class="link" bindtap="progress">检查进度</button></view><view wx:if="{{job.error}}" class="notice error">{{job.error}}</view>
      <view class="actions"><button class="primary" bindtap="generate" disabled="{{loading||job.busy||!result.portfolio.holdings.length}}">{{job.busy?'正在分析':'分析当前配置'}}</button><button wx:if="{{result.latest_report}}" bindtap="report">打开配置报告</button></view>
    </view>
    <view class="section"><view class="section-title">更多分析</view><view class="toolbar wrap"><button class="link" bindtap="detail" data-kind="stress">压力测试</button><button class="link" bindtap="detail" data-kind="optimizer">调整配置</button><button class="link" bindtap="detail" data-kind="events">事件关联</button><button class="link" bindtap="detail" data-kind="monitoring">风险跟踪</button></view></view>
  </view>
</view>
