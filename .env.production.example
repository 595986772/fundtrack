# 复制到仓库外的私有位置，再用 docker compose --env-file 指定该文件。
# 所有密码使用 URL-safe 字符，因为 PostgreSQL 连接串需要解析密码。
FUNDSCOPE_IMAGE_TAG=2026-09-23-v1
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=https://localhost:8443
PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_PORT=8443
# TLS_CERT_DIR=./infra/tls
POSTGRES_PASSWORD=replace-with-unique-url-safe-value
OPENFGA_POSTGRES_PASSWORD=replace-with-another-unique-url-safe-value
OPENFGA_TOKEN=replace-with-random-token
DEEPSEEK_API_KEY=replace-with-model-api-key
DASHSCOPE_API_KEY=replace-with-embedding-api-key

# 先用本地记录验证，再配置外部或自托管 Langfuse；不影响任务/费用数据库。
TRACE_ENABLED=true
TRACE_LOCAL_ENABLED=true
TRACE_SAMPLE_RATE=1.0
TRACE_OTLP_ENDPOINT=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
