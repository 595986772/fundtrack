<view class="page"><view class="row"><view class="heading">社区热点</view><button class="icon-button" bindtap="settings" aria-label="设置"><image class="icon" src="/assets/settings.png" /></button></view>
<view class="segments"><button wx:for="{{segments}}" wx:key="value" class="segment {{segment===item.value?'active':''}}" bindtap="change" data-value="{{item.value}}">{{item.label}}</button></view>
<view class="toolbar wrap"><button class="primary" bindtap="collect" disabled="{{job.busy || !status || !status.collection_allowed}}">采集样本</button><button bindtap="load" disabled="{{loading}}">读取已保存数据</button><button class="link" bindtap="config">采集状态</button></view>
<view wx:if="{{status && status.access_message}}" class="notice">{{status.access_message}}</view>
<view wx:if="{{job.message || job.error}}" class="notice">{{job.message}}<text class="error">{{job.error}}</text><button class="link" bindtap="checkJob">检查进度</button></view>
<view wx:if="{{segment !== 'topics'}}" class="field"><text class="label">样本范围</text><picker range="{{scopes}}" value="{{sampleScope}}" bindchange="scopeChange"><view class="select">{{scopes[sampleScope]}}</view></picker></view>
<view class="footnote">{{info}}</view><view wx:if="{{error}}" class="notice error">{{error}}</view><view wx:if="{{loading}}" class="empty">正在读取社区证据…</view>
<view wx:if="{{segment !== 'review'}}"><view wx:for="{{rows}}" wx:key="id" class="item" bindtap="detail" data-id="{{item.id}}" aria-label="{{item.title}}"><view class="item-title">{{item.title}}</view><view class="footnote">{{item.meta}}</view><view class="prose muted">{{item.content_excerpt}}</view><view class="link">查看正文与证据</view></view><view wx:if="{{!loading && !rows.length && !error}}" class="empty">尚无可展示的{{segment==='topics'?'聚合话题':'帖子'}}，可查看原始样本或采集状态。</view></view>
<view wx:if="{{segment==='samples'}}" class="row field"><button bindtap="page" data-delta="-1" disabled="{{page<=1 || loading}}">上一页</button><text>第 {{page}} 页 · {{total}} 条</text><button bindtap="page" data-delta="1" disabled="{{page*10>=total || loading}}">下一页</button></view>
<view wx:if="{{segment==='review'}}"><button class="primary field" bindtap="review" disabled="{{job.busy}}">AI 综合复核</button><view wx:for="{{blocks}}" wx:key="key" class="report-block {{item.kind}}"><view class="{{item.kind==='heading'?'section-title':'small muted'}}">{{item.label}}</view><text class="prose" selectable="true">{{item.text}}</text><button wx:if="{{item.url}}" class="link" bindtap="source" data-url="{{item.url}}">复制来源链接</button></view></view>
</view>
