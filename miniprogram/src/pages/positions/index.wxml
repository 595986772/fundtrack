<view class="page"><view class="eyebrow">ASSETS / LEDGER</view><view class="heading">{{id ? '补录实际持仓' : '新建资产账本'}}</view><view wx:if="{{loading}}" class="footnote">正在读取…</view><view wx:if="{{error}}" class="notice error">{{error}}</view><view wx:if="{{locked && !error}}" class="notice">已有交易的账本请通过交易记账调整，不能整体覆盖。</view>
  <view wx:if="{{!locked && !loading}}"><view class="field"><text class="label">账本名称</text><input value="{{name}}" bindinput="name" maxlength="80" placeholder="例如：长期投资" disabled="{{saving}}" /></view>
    <view class="toolbar"><picker range="{{funds}}" range-key="short_name" value="{{fundIndex}}" bindchange="choose" disabled="{{saving}}"><view class="select">{{funds.length ? funds[fundIndex].short_name : '暂无已导入基金'}} ▾</view></picker><button class="icon-button" bindtap="add" disabled="{{saving || !funds.length}}" aria-label="添加基金"><image class="icon" src="/assets/plus.png" /></button></view>
    <view wx:for="{{rows}}" wx:key="fund_code" class="section"><view class="row"><view class="grow"><view class="item-title">{{item.short_name}}</view><view class="muted small">{{item.fund_code}}</view></view><button class="icon-button" bindtap="remove" data-index="{{index}}" disabled="{{saving}}" aria-label="移除基金"><image class="icon" src="/assets/trash.png" /></button></view><view class="field"><text class="label">当前持有份额</text><input type="digit" value="{{item.units}}" data-index="{{index}}" data-field="units" bindinput="field" placeholder="以基金平台确认为准" disabled="{{saving}}" /></view><view class="field"><text class="label">剩余持仓成本 / 元</text><input type="digit" value="{{item.cost_amount}}" data-index="{{index}}" data-field="cost_amount" bindinput="field" placeholder="不是当前市值" disabled="{{saving}}" /></view><view class="field"><text class="label">持仓录入基准日</text><picker mode="date" value="{{item.purchase_date}}" end="{{today}}" data-index="{{index}}" data-field="purchase_date" bindchange="field" disabled="{{saving}}"><view class="select">{{item.purchase_date || '选择日期'}}</view></picker></view></view>
    <view wx:if="{{!rows.length}}" class="empty">尚未添加基金</view><view class="actions"><button class="primary" bindtap="save" disabled="{{saving || !rows.length}}">{{saving ? '正在保存…' : '保存持仓'}}</button></view><view class="footnote">初始记录不补造历史交易。此前已实现收益与分红不会凭空计入累计盈亏。</view>
  </view>
</view>
