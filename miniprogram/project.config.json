{
  "description": "FundScope 小程序本地开发版",
  "miniprogramRoot": "dist/",
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "FundScope",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "minified": true,
    "postcss": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "condition": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "packOptions": {
    "ignore": [
      {
        "value": "preview-manifest.json",
        "type": "file"
      },
      {
        "value": "app.css",
        "type": "file"
      },
      {
        "value": "preview-vendor",
        "type": "folder"
      }
    ],
    "include": []
  },
  "simulatorPluginLibVersion": {},
  "editorSetting": {}
}
