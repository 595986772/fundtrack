{
  "id": "fund-agent-v2",
  "version": "2.0.0",
  "name": "FundScope 固定快照业务回归集 v2",
  "description": "使用固定基金、市场和事件快照，验证路由、工具选择、事实一致性、证据引用、回答质量与调用效率。",
  "data_profile": "fundscope-fixture-v1",
  "defaults": {
    "max_tool_rounds": 4,
    "max_tool_calls": 1,
    "reject_absolute_claims": true
  },
  "fixtures": {
    "portfolios": {
      "balanced_learning": {
        "name": "评测用三基金组合",
        "holdings": [
          {"fund_code": "110020", "weight_pct": 50},
          {"fund_code": "161725", "weight_pct": 30},
          {"fund_code": "110007", "weight_pct": 20}
        ]
      }
    }
  },
  "scenarios": [
    {
      "id": "profile-index-basic",
      "category": "fund_profile",
      "tags": ["smoke", "facts"],
      "name": "宽基基金基础档案",
      "description": "名称和类型必须来自基金档案工具，不能依赖模型记忆。",
      "fund_code": "110020",
      "message": "请告诉我当前基金的代码、名称、基金类型和数据截止日。",
      "expected_route": "fund_profile",
      "required_tools": ["get_fund_profile_tool"],
      "forbidden_tools": ["get_fund_nav_summary_tool", "get_fund_risk_tool", "get_fund_assessment_tool"],
      "tool_result_assertions": [
        {"name": "读取固定基金代码", "tool": "get_fund_profile_tool", "path": "fund_code", "operator": "equals", "expected": "110020"},
        {"name": "读取固定基金名称", "tool": "get_fund_profile_tool", "path": "short_name", "operator": "equals", "expected": "易方达沪深300ETF联接A"},
        {"name": "使用固定快照", "tool": "get_fund_profile_tool", "path": "data_mode", "operator": "equals", "expected": "fixture"},
        {"name": "固定截止日正确", "tool": "get_fund_profile_tool", "path": "snapshot_end", "operator": "equals", "expected": "2026-08-25"}
      ],
      "required_answer_groups": [
        {"name": "回答基金身份", "terms": ["110020", "易方达沪深300"], "match": "all"},
        {"name": "说明数据日期", "terms": ["2026-08-25", "截至", "截止"], "match": "any"}
      ]
    },
