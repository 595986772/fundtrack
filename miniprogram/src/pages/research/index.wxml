<view class="page research-page"><view class="row"><view class="heading">AI 投研</view><button class="icon-button" bindtap="settings" aria-label="设置"><image class="icon" src="/assets/settings.png" /></button></view>
<view class="toolbar wrap"><button bindtap="toggleHistory" disabled="{{busy}}">历史对话</button><button bindtap="reports">研究报告</button><button bindtap="records">决策记录</button></view>
<view wx:if="{{showHistory}}" class="section"><view class="row"><button class="primary" bindtap="newConversation" disabled="{{busy}}">新对话</button><button class="link" bindtap="deleteConversation" disabled="{{!conversationId||busy}}">删除当前对话</button></view><view wx:for="{{conversations}}" wx:key="id" class="item" bindtap="selectConversation" data-id="{{item.id}}">{{item.title}}</view><view wx:if="{{!conversations.length}}" class="empty">暂无历史对话</view></view>
<view class="field"><text class="label">本轮研究对象</text><picker range="{{contexts}}" value="{{context}}" bindchange="field" data-field="context" disabled="{{busy}}"><view class="select">{{contexts[context]}}</view></picker></view>
<picker wx:if="{{context==0}}" class="field" range="{{portfolios}}" range-key="name" value="{{portfolio}}" bindchange="field" data-field="portfolio" disabled="{{busy}}"><view class="select">{{portfolios[portfolio] ? portfolios[portfolio].name : '尚无账本'}}</view></picker>
<picker wx:if="{{context==1}}" class="field" range="{{funds}}" range-key="short_name" value="{{fund}}" bindchange="field" data-field="fund" disabled="{{busy}}"><view class="select">{{funds[fund] ? funds[fund].short_name : '尚无已导入基金'}}</view></picker>
<view wx:if="{{loading}}" class="empty">正在恢复对话…</view>
<view wx:if="{{researchReference}}" class="notice"><view>正在追问：{{researchReference.headline || researchReference.portfolio_name}}</view><view class="small">{{researchReference.assessment_date || ''}}</view><view class="row"><button class="link" bindtap="sourceReport">查看引用报告</button><button class="link" bindtap="newConversation" disabled="{{busy}}">开始新话题</button></view></view>
<view wx:if="{{fundReportReference}}" class="notice"><view>季报研究 · {{fundReportReference.fund_code}} · 固定两期原文</view><view class="row"><button class="link" bindtap="sourceFundReports">查看引用季报</button><button class="link" bindtap="newConversation" disabled="{{busy}}">开始新话题</button></view></view>
<view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}"><view class="small muted">{{item.role==='user'?'你':'FundScope'}}</view><text class="prose" selectable="true">{{item.content}}</text><view wx:if="{{item.role==='assistant'}}" class="row"><button class="link" bindtap="evidence" data-id="{{item.id}}">证据与运行记录</button><button class="icon-button" bindtap="copy" data-id="{{item.id}}" aria-label="复制回答"><image class="icon" src="/assets/copy.png" /></button></view></view>
<view wx:if="{{partial}}" class="message assistant"><text class="prose" selectable="true">{{partial}}</text></view>
<view wx:if="{{phase}}" class="notice">{{phase}}<button wx:if="{{trace.length}}" class="link" bindtap="toggleTrace">{{showTrace?'收起':'查看'}}运行过程</button><view wx:if="{{showTrace}}"><view wx:for="{{trace}}" wx:key="index" class="footnote">{{item}}</view></view></view>
<view wx:if="{{error}}" class="notice error">{{error}}</view>
<view class="composer"><text class="label">研究问题</text><textarea value="{{question}}" bindinput="field" data-field="question" maxlength="800" disabled="{{busy}}" auto-height="true" placeholder="这份配置有哪些风险？还有哪些证据需要核实？" aria-label="研究问题" />
<view class="row field"><text class="small">仅本轮允许补查公开数据</text><switch checked="{{refreshAllowed}}" bindchange="field" data-field="refreshAllowed" disabled="{{busy}}" color="#a48023" /></view>
<view class="row field"><button class="link" bindtap="multi" disabled="{{busy}}">多视角研判草稿</button><button wx:if="{{busy}}" class="icon-button" bindtap="stop" aria-label="停止回答"><image class="icon" src="/assets/stop.png" /></button><button wx:else class="icon-button primary" bindtap="send" disabled="{{loading||!question}}" aria-label="发送研究问题"><image class="icon" src="/assets/send.png" /></button></view></view>
</view>
