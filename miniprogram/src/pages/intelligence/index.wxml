<view class="page">
  <view class="row"><view class="heading">事件情报</view><button class="icon-button" bindtap="settings" aria-label="设置"><image class="icon" src="/assets/settings.png" /></button></view>
  <view class="segments"><button class="segment {{segment === 'events' ? 'active' : ''}}" data-value="events" bindtap="change">事件列表</button><button class="segment {{segment === 'trends' ? 'active' : ''}}" data-value="trends" bindtap="change">热度变化</button></view>
  <view class="toolbar"><input class="grow" value="{{query}}" bindinput="field" data-field="query" maxlength="100" placeholder="搜索已保存的事件" aria-label="事件关键词" /><button class="icon-button" bindtap="load" disabled="{{loading}}" aria-label="搜索事件"><image class="icon" src="/assets/search.png" /></button></view>
  <view class="toolbar"><button wx:if="{{segment==='events'}}" class="link" bindtap="toggleFilters">{{showFilters?'收起筛选':'筛选条件'}}</button><button class="link" bindtap="toggleCollection">{{showCollection?'收起数据操作':'采集与分析'}}</button></view>
  <view wx:if="{{segment === 'events' && showFilters}}" class="section"><view class="row wrap field"><view class="grow"><text class="label">起始日期</text><picker mode="date" value="{{dateFrom}}" bindchange="field" data-field="dateFrom"><view class="select">{{dateFrom || '不限'}}</view></picker></view><view class="grow"><text class="label">结束日期</text><picker mode="date" value="{{dateTo}}" bindchange="field" data-field="dateTo"><view class="select">{{dateTo || '不限'}}</view></picker></view></view>
    <view class="field"><text class="label">关联基金代码</text><input value="{{fundCode}}" bindinput="field" data-field="fundCode" type="number" maxlength="6" placeholder="不限基金" /></view>
    <view class="row field"><picker range="{{types}}" value="{{eventType}}" bindchange="field" data-field="eventType"><view class="select">{{types[eventType]}}</view></picker><picker range="{{levels}}" value="{{sourceLevel}}" bindchange="field" data-field="sourceLevel"><view class="select">{{levels[sourceLevel]}}</view></picker></view>
    <view class="actions field"><button class="primary" bindtap="load" disabled="{{loading}}">应用筛选</button><button bindtap="clearFilters">清除筛选</button></view>
  </view>
  <view wx:if="{{showCollection}}" class="section"><view class="row"><text class="label">采集板块</text><picker range="{{topics}}" range-key="topic" value="{{topic}}" bindchange="field" data-field="topic"><view class="select">{{topics[topic] ? topics[topic].topic : '全部板块'}}</view></picker></view><view class="row field"><text>AI 扩展采集关键词</text><switch checked="{{expansion}}" color="#a48023" bindchange="field" data-field="expansion" /></view><button class="primary field" bindtap="refresh" disabled="{{job.busy}}">获取最新情报</button><view class="actions field"><button bindtap="processSaved" data-action="analyze" disabled="{{job.busy}}">分析已保存资讯</button><button bindtap="processSaved" data-action="cluster" disabled="{{job.busy}}">聚类已保存资讯</button></view></view>
  <view wx:if="{{job.message || job.error}}" class="notice"><text>{{job.message}}</text><text class="error">{{job.error}}</text><button class="link" bindtap="checkJob">检查进度</button></view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view><view wx:if="{{loading}}" class="empty">正在读取…</view>
  <view class="footnote">{{info}}</view>
  <view wx:for="{{rows}}" wx:key="id" class="item" bindtap="detail" data-id="{{item.id}}" aria-label="{{item.title}}"><view class="item-title">{{item.title}}</view><view class="footnote">{{item.meta}}</view><view class="prose">{{item.summary}}</view><view wx:if="{{item.ai}}" class="prose muted">AI：{{item.ai}}</view><view class="link">查看证据</view></view>
  <view wx:if="{{!loading && !rows.length && !error}}" class="empty">没有匹配的已保存记录</view>
  <button wx:if="{{segment === 'events' && total > rows.length && limit < 50}}" class="link" bindtap="more">显示更多</button>
  <view wx:if="{{total > rows.length}}" class="footnote">已显示 {{rows.length}} / {{total}} 条，可缩小关键词或日期范围。</view>
</view>
