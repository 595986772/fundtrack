      "forbidden_tools": ["get_fund_nav_summary_tool", "get_fund_risk_tool", "get_fund_assessment_tool"],
      "tool_result_assertions": [
        {"name": "基金经理正确", "tool": "get_fund_profile_tool", "path": "fund_managers", "operator": "equals", "expected": "侯昊"},
        {"name": "跟踪标的正确", "tool": "get_fund_profile_tool", "path": "tracking_target", "operator": "equals", "expected": "中证白酒指数"},
        {"name": "管理费正确", "tool": "get_fund_profile_tool", "path": "management_fee", "operator": "contains", "expected": "1.00%"}
