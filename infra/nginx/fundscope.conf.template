# Nginx 官方镜像只替换 PUBLIC_HOST / PUBLIC_ORIGIN，保留自身的 $request_uri 等变量。
server {
    listen 80;
    server_name ${PUBLIC_HOST};
    return 308 ${PUBLIC_ORIGIN}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${PUBLIC_HOST};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    client_max_body_size 25m;

    # 代理只接受配置域名；其他 Host 不应转发给 FastAPI。
    if ($host != "${PUBLIC_HOST}") { return 421; }

    location = /livez { return 404; }
    location = /readyz { return 404; }

    # 聊天流与后台 Job 进度都必须逐段透传。read_timeout 是两次读取之间的上限。
    location ~ ^/(api/v1/(developer/)?agent/chat/stream|background-jobs/[^/]+/events)$ {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
    }

    location / {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
