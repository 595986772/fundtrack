<view class="page"><view class="row"><view class="heading grow">{{title}}</view><button class="icon-button" bindtap="load" disabled="{{loading||busy}}" aria-label="重新读取"><image class="icon" src="/assets/refresh.png" /></button></view>
<view wx:if="{{needsPortfolio}}" class="field"><text class="label">账本</text><picker range="{{portfolios}}" range-key="name" value="{{selected}}" bindchange="choose" disabled="{{busy}}"><view class="select">{{portfolios[selected] ? portfolios[selected].name : '尚无账本'}}</view></picker></view>
<view wx:if="{{kind==='performance'||kind==='risk'||kind==='stress'||kind==='fund-risk'||kind==='fund-assessment'}}" class="field"><text class="label">历史样本（月）</text><picker range="{{monthsOptions}}" value="{{monthIndex}}" bindchange="period" disabled="{{busy}}"><view class="select">{{months}}个月</view></picker></view>
<view wx:if="{{kind==='capital'}}" class="field"><text class="label">资金统计窗口</text><picker range="{{windowPeriods}}" value="{{windowPeriod}}" bindchange="capitalPeriod"><view class="select">{{windowPeriods[windowPeriod]}}</view></picker></view>
<view wx:if="{{kind==='turnover'}}" class="field"><text class="label">市场／指数</text><picker range="{{turnoverSeries}}" range-key="label" value="{{turnoverIndex}}" bindchange="turnoverChange" data-field="turnoverIndex" disabled="{{busy}}"><view class="select">{{turnoverSeries[turnoverIndex] ? turnoverSeries[turnoverIndex].label : '选择市场'}}</view></picker><picker class="field" range="{{turnoverPeriods}}" value="{{turnoverPeriod}}" bindchange="turnoverChange" data-field="turnoverPeriod" disabled="{{busy}}"><view class="select">{{turnoverPeriods[turnoverPeriod]}}</view></picker></view>
<view wx:if="{{kind==='stress'}}" class="field"><text class="label">连续共同观察日</text><picker range="{{dayOptions}}" value="{{dayIndex}}" bindchange="days"><view class="select">{{days}}日</view></picker><button class="primary field" data-action="stress" bindtap="act" disabled="{{busy||loading||!portfolio}}">运行压力测试</button></view>
<button wx:if="{{kind==='monitoring'}}" class="primary field" data-action="monitor" bindtap="act" disabled="{{busy||loading||job.busy||!portfolio}}">立即检查风险</button>
<view wx:if="{{kind==='adjustment'&&!record}}" class="section"><button class="primary" data-action="adjustment" bindtap="act" disabled="{{busy||loading||job.busy||!id}}">基于研究报告生成调整方案</button></view>
<button wx:if="{{kind==='capital'||kind==='retail'||kind==='turnover'}}" class="primary field" data-action="refresh" bindtap="act" disabled="{{busy||loading||job.busy}}">获取最新数据</button>
<view wx:if="{{kind==='social-settings'}}" class="section"><view class="notice">登录、扫码和平台验证需要在运行后端的电脑上完成。小程序只查看状态或发起连接，不解除平台风控。</view><button class="field" data-action="login" bindtap="act" disabled="{{busy||loading||job.busy||!record||record.verification_required}}">在后端电脑连接小红书</button></view>
<view wx:if="{{kind==='optimizer'}}" class="section"><text class="label">配置要求</text><textarea value="{{question}}" bindinput="field" data-field="question" maxlength="2000" auto-height="true" disabled="{{busy}}" placeholder="债券类至少40%，单只最多60%，单边换手最多20%" /><button class="primary field" data-action="draft" bindtap="act" disabled="{{busy||loading||!portfolio||!question}}">AI 整理为新草案</button><view class="footnote">仅生成研究方案，不修改实际持仓。</view></view>
<view wx:if="{{kind==='decisions'}}" class="section"><text class="label">记录决策</text><picker range="{{decisionActions}}" value="{{decisionAction}}" bindchange="field" data-field="decisionAction"><view class="select">{{decisionActions[decisionAction]}}</view></picker><view class="field"><text class="label">观察天数</text><picker range="{{horizons}}" value="{{decisionHorizon}}" bindchange="field" data-field="decisionHorizon"><view class="select">{{horizons[decisionHorizon]}}天</view></picker></view><textarea class="field" value="{{thesis}}" bindinput="field" data-field="thesis" maxlength="2000" placeholder="记录当时的理由和需要验证的条件" /><button class="primary field" data-action="decision" bindtap="act" disabled="{{busy||loading||!portfolio}}">保存决策</button></view>
<view wx:if="{{history.length}}" class="section"><view class="section-title">历史记录</view><view wx:for="{{history}}" wx:key="id" class="item" bindtap="selectRecord" data-id="{{item.id}}"><view class="item-title">{{item.title}}</view><view class="footnote">{{item.meta}}</view></view></view>
<view wx:if="{{error}}" class="notice error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><view wx:if="{{loading||busy}}" class="empty">{{busy?'正在处理…':'正在读取…'}}</view>
<view wx:if="{{job.message||job.error}}" class="notice">{{job.message}}<text class="error">{{job.error}}</text><button class="link" bindtap="checkJob">检查进度</button></view>
<button wx:if="{{record&&kind!=='social-settings'}}" class="link field" bindtap="ask">交给 AI 分析</button>
<button wx:if="{{kind==='fund-assessment'&&record}}" class="field" data-action="analyze" bindtap="act" disabled="{{busy}}">AI 语义复核</button>
<ec-canvas wx:if="{{chartAvailable}}" id="report-chart" canvas-id="report-canvas" ec="{{ec}}" class="chart" />
<view wx:for="{{blocks}}" wx:key="key" class="report-block {{item.kind}}"><view class="{{item.kind==='heading'?'section-title':'small muted'}}">{{item.label}}</view><text class="prose" selectable="true">{{item.text}}</text><button wx:if="{{item.url}}" class="link" bindtap="source" data-url="{{item.url}}">复制来源链接</button></view>
<view wx:for="{{links}}" wx:key="id" class="item" bindtap="link" data-kind="{{item.kind}}" data-id="{{item.id}}" data-portfolio="{{item.portfolio}}"><text class="accent">{{item.title}}</text></view>
<view wx:if="{{images.length}}" class="section"><view class="section-title">原始图片</view><image wx:for="{{images}}" wx:key="src" class="evidence-image" src="{{item.src}}" mode="widthFix" bindtap="image" data-src="{{item.src}}" aria-label="{{item.label}}" /></view>
<view wx:if="{{kind==='optimizer'&&record&&!record.result}}" class="section"><view class="section-title">确认求解条件</view><view wx:for="{{constraints}}" wx:key="key" class="field"><text class="label">{{item.label}}</text><input type="digit" value="{{item.value}}" bindinput="constraint" data-key="{{item.key}}" disabled="{{busy}}" /></view><view class="row field"><text class="small grow">我已核对条件、基金分类及冻结数据，仅生成研究方案。</text><switch checked="{{ack}}" bindchange="field" data-field="ack" disabled="{{busy}}" color="#a48023" /></view><button class="primary field" data-action="solve" bindtap="act" disabled="{{busy||!canSolve}}">确认条件并求解</button></view>
<button wx:if="{{kind==='stress'&&record&&record.run_id}}" class="field" bindtap="act" data-action="verify" disabled="{{busy}}">用冻结数据复算</button>
<view wx:if="{{kind==='stress'&&record&&record.run_id}}" class="section"><view class="section-title">比较候选配置</view><view wx:for="{{weights}}" wx:key="code" class="field"><text class="label">{{item.name}} · {{item.code}} (%)</text><input type="digit" value="{{item.value}}" bindinput="weight" data-code="{{item.code}}" disabled="{{busy}}" /></view><button class="primary field" bindtap="act" data-action="weights" disabled="{{busy}}">在同一冻结情景下比较</button><view class="footnote">非负权重合计100%，只生成对比报告，不修改持仓。</view></view>
<view wx:if="{{kind==='monitoring'&&record&&record.policy}}" class="section"><view class="section-title">风险跟踪策略</view><view class="row field"><text>启用已有定时跟踪</text><switch checked="{{policyEnabled}}" bindchange="field" data-field="policyEnabled" disabled="{{busy}}" color="#a48023" /></view><view wx:for="{{policyFields}}" wx:key="key" class="field"><text class="label">{{item.label}}</text><input type="digit" value="{{item.value}}" bindinput="policyField" data-key="{{item.key}}" disabled="{{busy}}" /></view><button class="field" bindtap="act" data-action="save-policy" disabled="{{busy}}">保存风险策略</button><view wx:for="{{record.alerts}}" wx:key="id" class="item"><view>{{item.title}}</view><button class="link" bindtap="act" data-action="acknowledge" data-id="{{item.id}}" disabled="{{busy||item.status==='acknowledged'}}">{{item.status==='acknowledged'?'已读':'标记已读'}}</button></view></view>
<view wx:if="{{kind==='adjustment'&&record&&record.status==='waiting_input'}}" class="section"><view class="section-title">确认研究约束</view><text class="label">风险偏好</text><picker range="{{riskPreferences}}" value="{{riskPreference}}" bindchange="field" data-field="riskPreference"><view class="select">{{riskPreferences[riskPreference]}}</view></picker><view class="field"><text class="label">投资期限</text><picker range="{{investmentHorizons}}" value="{{horizon}}" bindchange="field" data-field="horizon"><view class="select">{{investmentHorizons[horizon]}}</view></picker></view><view class="field"><text class="label">单只调整幅度上限 (%)</text><input type="digit" value="{{singleAdjustment}}" bindinput="field" data-field="singleAdjustment" /></view><view class="field"><text class="label">单只权重上限 (%)</text><input type="digit" value="{{maxSingle}}" bindinput="field" data-field="maxSingle" /></view><view class="field"><text class="label">单边换手上限 (%)</text><input type="digit" value="{{maxTurnover}}" bindinput="field" data-field="maxTurnover" /></view><textarea class="field" value="{{additional}}" bindinput="field" data-field="additional" maxlength="1000" placeholder="其他研究约束" /><view class="row field"><text class="small grow">我已核对上述约束，仅生成方案，不执行交易。</text><switch checked="{{ack}}" bindchange="field" data-field="ack" color="#a48023" /></view><view class="actions"><button class="primary" bindtap="act" data-action="resume" disabled="{{busy||!ack}}">确认并继续</button><button bindtap="act" data-action="cancel-adjustment" disabled="{{busy}}">取消方案</button></view></view>
<view wx:if="{{kind==='decisions'&&record&&record.id}}" class="section"><text class="label">复盘笔记</text><textarea value="{{reviewNote}}" bindinput="field" data-field="reviewNote" maxlength="2000" placeholder="哪些假设得到验证，哪些没有？" /><button class="field" data-action="review" bindtap="act" disabled="{{busy}}">保存复盘</button><button class="link" data-action="delete-decision" bindtap="act" disabled="{{busy}}">删除这条记录</button></view>
</view>
