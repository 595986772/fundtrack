<view class="page"><view class="eyebrow">FUNDSCOPE / ACCOUNT</view><view class="heading">我的</view><view class="notice">{{status}}</view><view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view class="section"><view class="section-title">后端连接</view><view class="field"><text class="label">服务地址</text><input value="{{baseUrl}}" data-field="baseUrl" bindinput="field" placeholder="http://127.0.0.1:8000" /></view><view class="field"><text class="label">FundScope 账号 / 本地用户 ID</text><input value="{{userId}}" data-field="userId" bindinput="field" maxlength="50" /></view><view class="actions"><button bindtap="connect" disabled="{{busy}}">连接本地工作区</button></view></view>
  <view class="section"><view class="section-title">账号登录</view><view class="field"><text class="label">密码</text><input password="{{true}}" value="{{password}}" data-field="password" bindinput="field" maxlength="128" placeholder="已有 FundScope 账号密码" /></view><view class="actions"><button class="primary" bindtap="login" disabled="{{busy}}">登录</button><button wx:if="{{loggedIn}}" bindtap="logout" disabled="{{busy}}">退出登录</button></view></view>
  <view class="footnote">FundScope · 小程序本地开发版</view>
</view>
