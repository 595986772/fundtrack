<view class="page"><view class="heading">{{name || '基金详情'}}</view><view class="muted small">{{code}} · {{type}}</view><view class="toolbar wrap"><button bindtap="analysis" data-kind="fund-holdings">持仓分析</button><button bindtap="analysis" data-kind="fund-risk">风险指标</button><button bindtap="analysis" data-kind="fund-assessment">综合研判</button><button class="link" bindtap="ask">AI 分析</button></view><view wx:if="{{error}}" class="notice error">{{error}}<button class="link" bindtap="load">重试</button></view><view wx:if="{{loading}}" class="empty">正在读取净值…</view>
  <navigator class="report-entry" url="/pages/fund-reports/index?code={{code}}">季度报告与两期对比</navigator>
  <view wx:if="{{!loading && !error}}"><view class="section"><view class="muted small">单位净值 / 元</view><view class="hero-value numeric">{{nav}}</view><view class="row"><text class="muted">{{date}}</text><text class="numeric {{dayTone}}">{{day}}</text></view><view class="fund-meta"><text>近30日 {{month}}</text><text>近3月 {{quarter}}</text></view></view>
    <view class="section"><view class="section-title">单位净值走势</view><view class="periods"><button wx:for="{{periods}}" wx:key="days" class="{{period === item.days ? 'active' : ''}}" data-days="{{item.days}}" bindtap="period">{{item.label}}</button></view><ec-canvas class="chart" id="nav-chart" canvas-id="fund-nav" ec="{{ec}}" /><view wx:if="{{!visiblePoints.length}}" class="empty">该区间暂无净值数据</view><view class="footnote">{{visiblePoints.length}} 个净值点 · 单位净值未经复权，不等同于含分红总回报。</view></view>
    <view class="section"><view class="muted small">基金管理人</view><view>{{company || '暂无档案'}}</view><view class="footnote">数据来源：{{source}} · 最新披露日 {{date}}</view></view>
  </view>
</view>
