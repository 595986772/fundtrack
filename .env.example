# 复制为 .env 或在终端中 export 这些变量。
# 注意：真实 API Key 不要提交到 Git。

APP_NAME=FundTrack
# 本地默认记录脱敏追踪，不配置远程入口时不会上传。API 与 Worker 使用同一配置。
TRACE_ENABLED=true
TRACE_LOCAL_ENABLED=true
TRACE_LOCAL_DIR=data/traces
TRACE_SAMPLE_RATE=1.0
TRACE_SERVICE_NAME=fundscope
TRACE_RELEASE=development
# 可选：标准 OTLP 完整入口，或下面的 Langfuse 项目凭据。两者只选一种。
TRACE_OTLP_ENDPOINT=
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# 投研模型单次等待预算；总尝试 2 次表示首次请求 + 最多 1 次重试。
AGENT_MODEL_TIMEOUT_SECONDS=90
AGENT_MODEL_MAX_ATTEMPTS=2
# 整次 HTTP 产品聊天共享 120 秒；最后 20 秒不再开新查询，留给收尾和保存。
AGENT_CHAT_BUDGET_ENABLED=true
AGENT_CHAT_TIMEOUT_SECONDS=120
AGENT_CHAT_FINALIZE_RESERVE_SECONDS=20
# 产品聊天的重复读取复用、无进展收尾与有限取证检查；不作用于开发者写工具。
AGENT_LOOP_GUARD_ENABLED=true
# 复杂只读问题可在当前循环中发现工具；普通单次查询不启用。
AGENT_TOOL_DISCOVERY_ENABLED=true
AGENT_TOOL_DISCOVERY_MAX_CALLS=2
AGENT_TOOL_DISCOVERY_TOP_K=3
AGENT_TOOL_DISCOVERY_MAX_SCHEMA_CHARS=16000
# 任务授权：根任务只授权用户选中的组合，子任务不能扩大范围。
AGENT_TASK_AUTHORIZATION_ENABLED=true
AGENT_TASK_GRANT_SECONDS=1800
# 本机 OpenFGA 独立容器；setup_openfga.py 把非秘密 store/model ID 保存到下述文件。
OPENFGA_URL=http://127.0.0.1:8091
OPENFGA_CONFIG_PATH=data/openfga.json
# 部署时可显式配置，优先于文件。TOKEN 只放真实 .env / secret store。
# OPENFGA_STORE_ID=
# OPENFGA_MODEL_ID=
# OPENFGA_TOKEN=
OPENFGA_TIMEOUT_SECONDS=3
# 季报共享预算。standard原模式；evidence不思考；balanced低强度思考（后两者实验用）。
FUND_REPORT_TIMEOUT_SECONDS=110
FUND_REPORT_SYNTHESIS_MODE=standard
# 可选备用 OpenAI 兼容模型；为空时不会产生额外模型客户端或调用。
# LLM_FALLBACK_MODEL=deepseek-chat
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com
# LLM_FALLBACK_API_KEY=你的_备用_api_key
AGENT_SYSTEM_PROMPT=You are a reliable project agent. Use tools when evidence or actions are required, and answer clearly.

# 本地迁移期可为 false；Docker/生产建议 true，并在 HTTPS 下开启 Secure Cookie。
AUTH_REQUIRED=true
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
CHAT_RATE_LIMIT_PER_MINUTE=20

# AI 调用治理：auto 本地单进程用 memory，Celery 用 Redis；多 API 进程显式选 redis。
AI_GOVERNANCE_ENABLED=true
AI_CONTROL_BACKEND=auto
AI_REDIS_URL=redis://127.0.0.1:6380/2
AI_REDIS_PREFIX=fundscope:{ai}
AI_MODEL_REQUESTS_PER_MINUTE=30
AI_GLOBAL_CONCURRENCY=4
AI_USER_CONCURRENCY=2
AI_GLOBAL_QUEUE_SIZE=20
AI_USER_QUEUE_SIZE=4
AI_QUEUE_WAIT_SECONDS=15
AI_SLOT_LEASE_SECONDS=120
# 以下单位都是 Token，不是人民币；异常未返回 usage 的调用继续占用待确认额度。
AI_DAILY_TOKEN_LIMIT=2000000
AI_RUN_TOKEN_LIMIT=500000
AI_MAX_OUTPUT_TOKENS=16384
AI_GLOBAL_PENDING_JOBS=32
AI_USER_PENDING_JOBS=6

# 阿里云百炼 / Qwen Embedding。真实值放到 .env，不要提交。
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# 可选季报精排，复用 DASHSCOPE_API_KEY。填写所属业务空间的真实完整地址。
# 留空时页面诊断明确显示未配置，仍可使用 BM25 + 向量 + RRF 检索。
# FUND_REPORT_RERANK_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
FUND_REPORT_RERANK_URL=
FUND_REPORT_RERANK_MODEL=qwen3-rerank
FUND_REPORT_RERANK_TIMEOUT_SECONDS=8
EMBEDDING_DIMENSIONS=1024

# Chroma 本地向量库配置。
CHROMA_PERSIST_DIR=data/chroma
# 本地不设置则沿用旧目录；正式 Compose 将季报和向量统一放进 /app/data。
FUND_REPORT_STORAGE_DIR=
CHROMA_COLLECTION=fastapi_demo_docs

# Agent Runtime 工程化底座。
# 本地直接启动可保持下面的 SQLite + local；Docker Compose 会自动覆盖成 PostgreSQL + Celery。
DATABASE_URL=sqlite:///data/agent_runtime.db
DATABASE_AUTO_CREATE_SCHEMA=true
# auto：SQLite 开发环境写本地文件，PostgreSQL 部署环境写共享数据库。
LANGGRAPH_CHECKPOINT_BACKEND=auto
# 默认复用 DATABASE_URL；只有需要把 checkpoint 单独放库时才取消下一行注释。
# LANGGRAPH_CHECKPOINT_DATABASE_URL=sqlite:///data/langgraph_checkpoints.db
JOB_EXECUTION_MODE=local
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
JOB_DEFAULT_TIMEOUT_SECONDS=300
JOB_DEFAULT_MAX_RETRIES=2
# 仅组合投研启用 Outbox + 租约恢复，既有任务不回填；需持久化 checkpoint。
RELIABLE_RESEARCH_JOBS_ENABLED=true
JOB_LEASE_SECONDS=60
# 心跳间隔自动取租约的 1/3；失联接管与普通异常重试分别计数。
JOB_RECOVERY_MAX_ATTEMPTS=2
JOB_OUTBOX_POLL_SECONDS=2
JOB_DELIVERY_ACK_SECONDS=30
JOB_SSE_POLL_SECONDS=0.35

# FundScope 工作日净值同步。Cron 使用运行环境的本地时区。
FUND_NAV_SYNC_ENABLED=false
FUND_NAV_SYNC_CRON=0 20 * * 1-5
# 风险调整收益的透明研究假设；不是实时国债或银行利率。
FUND_RISK_FREE_RATE_ANNUAL_PCT=0.0
FUND_BENCHMARK_CASH_RATE_ANNUAL_PCT=0.0
MARKET_SNAPSHOT_SYNC_ENABLED=false
MARKET_SNAPSHOT_SYNC_CRON=15 20 * * 1-5
# 市场情报默认手动刷新；改为 true 才会注册下面这条工作日 Cron。
MARKET_EVENT_SYNC_ENABLED=false
MARKET_EVENT_SYNC_CRON=30 20 * * 1-5
MARKET_EVENT_SYNC_LOOKBACK_DAYS=120
MARKET_INTELLIGENCE_MAX_ANALYSIS_BATCHES=5
MARKET_EVENT_HTTP_TIMEOUT_SECONDS=12
MARKET_EVENT_MAX_ITEMS_PER_SOURCE=30

# 小红书公开观点使用本机 Chrome + Playwright 低频采集，不需要第三方 API Key。
# 首次使用需在市场页点击“连接小红书”，并在弹出的独立 Chrome 中手动登录。
XHS_SOCIAL_SIGNAL_ENABLED=false
XHS_BROWSER_PROFILE_DIR=data/xhs_browser_profile
XHS_BROWSER_CHANNEL=chrome
# false 会让手动刷新时显示浏览器过程，更容易发现登录失效或平台验证页面。
XHS_BROWSER_HEADLESS=false
XHS_BROWSER_LOGIN_TIMEOUT_SECONDS=300
XHS_BROWSER_NAVIGATION_TIMEOUT_SECONDS=30
XHS_BROWSER_SETTLE_SECONDS=2
XHS_BROWSER_SCROLL_ROUNDS=1
# 本项目两次采集至少间隔 15 分钟；平台要求验证时必须人工处理，不会到点自动采集。
XHS_BROWSER_MIN_REFRESH_SECONDS=900
# 每篇最多缓存3张公开图片，每次采集最多6张；OCR在本地运行，不需要新增API Key。
XHS_SOCIAL_IMAGE_LIMIT=3
XHS_SOCIAL_IMAGE_BUDGET=6
SOCIAL_MEDIA_DIR=data/social_media
XHS_BROWSER_LOGIN_COOKIE_NAMES=web_session
XHS_SOCIAL_SIGNAL_KEYWORDS=基金实盘,基金今日加仓,基金今日减仓,基金操作
# 可选：逗号分隔最多 50 个公开作者主页。不配置时仍按关键词搜索。
XHS_SOCIAL_SIGNAL_AUTHOR_URLS=
XHS_SOCIAL_SIGNAL_MAX_AUTHORS=50
XHS_SOCIAL_SIGNAL_MAX_KEYWORDS=4
XHS_SOCIAL_SIGNAL_MAX_POSTS_PER_REFRESH=24
XHS_SOCIAL_SIGNAL_MAX_DETAIL_REQUESTS=8
XHS_SOCIAL_SIGNAL_LOOKBACK_HOURS=18
XHS_SOCIAL_SIGNAL_ANALYSIS_BATCHES=4
XHS_SOCIAL_SIGNAL_CUTOFF_HOUR=15
XHS_SOCIAL_SIGNAL_CUTOFF_MINUTE=0
XHS_SOCIAL_SIGNAL_MIN_AUTHORS=3
